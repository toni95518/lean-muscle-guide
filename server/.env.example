# PostgreSQL connection string
DATABASE_URL="postgresql://fuel:fuel@localhost:5432/fuel_move?schema=public"

# Long random string used to sign login tokens (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=3000

# Optional: comma-separated origins allowed to call the API from a browser
# on another domain. Not needed when the web app is served by this server.
CORS_ORIGIN=""

# Optional: WeChat Mini Program login (POST /api/auth/wechat)
WECHAT_APPID=""
WECHAT_SECRET=""
