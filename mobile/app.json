{
  "expo": {
    "name": "Lean Muscle Guide",
    "slug": "lean-muscle-guide",
    "version": "0.99.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "leanmuscleguide",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F5F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leanmuscleguide.app",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.leanmuscleguide.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "zh": "./locales/zh.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of your meal so your AI can estimate its calories.",
          "photosPermission": "Choose a photo of your meal so your AI can estimate its calories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
