{
  "expo": {
    "name": "Lean Muscle Guide",
    "slug": "lean-muscle-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "leanmuscleguide",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leanmuscleguide.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "com.leanmuscleguide.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "zh": "./locales/zh.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of your meal so your AI can estimate its calories.",
          "photosPermission": "Choose a photo of your meal so your AI can estimate its calories."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F2F5F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "867b19ce-69c7-46cf-bf87-8f2b642b4c42"
      }
    },
    "owner": "toni95518"
  }
}
